## 4. Schema Database (`banksoal/models.py`)

```python
from django.db import models
from django.contrib.auth.models import User


class WhitelistAsdos(models.Model):
    npm = models.CharField(max_length=15, unique=True)
    nama_catatan = models.CharField(max_length=100, blank=True, help_text="Contoh: Asdos DDP 1 - Budi")

    class Meta:
        verbose_name_plural = "Whitelist Asdos"

    def __str__(self):
        return f"{self.npm} - {self.nama_catatan}"


class UserProfile(models.Model):
    ROLE_CHOICES = [
        ('MAHASISWA', 'Mahasiswa'),
        ('ASDOS', 'Asdos'),
    ]
    user = models.OneToOneField(User, on_delete=models.CASCADE, related_name='profile')
    npm = models.CharField(max_length=15, unique=True)
    nama_lengkap = models.CharField(max_length=150)
    role = models.CharField(max_length=15, choices=ROLE_CHOICES, default='MAHASISWA')

    @property
    def is_asdos(self):
        return self.role == 'ASDOS'

    def __str__(self):
        return f"{self.nama_lengkap} ({self.npm}) - {self.role}"


class Semester(models.Model):
    nama = models.CharField(max_length=50, help_text="Contoh: Semester 1")
    urutan = models.PositiveIntegerField(unique=True, help_text="Angka urutan: 1, 2, 3, dst.")

    class Meta:
        ordering = ['urutan']

    def __str__(self):
        return self.nama


class MataKuliah(models.Model):
    semester = models.ForeignKey(Semester, on_delete=models.CASCADE, related_name='mata_kuliah')
    kode_mk = models.CharField(max_length=20, help_text="Contoh: CSGE601020")
    nama_mk = models.CharField(max_length=100, help_text="Contoh: Dasar-Dasar Pemrograman 1")

    class Meta:
        ordering = ['nama_mk']
        verbose_name_plural = "Mata Kuliah"

    def __str__(self):
        return f"{self.kode_mk} - {self.nama_mk}"


class Soal(models.Model):
    KATEGORI_CHOICES = [
        ('PRE_CLASS', 'Pre-Class Quiz'),
        ('POST_CLASS', 'Post-Class Quiz'),
        ('ASISTENSI', 'Latihan Asistensi / Lab'),
        ('UTS', 'UTS'),
        ('UAS', 'UAS'),
        ('LAINNYA', 'Lainnya'),
    ]

    mata_kuliah = models.ForeignKey(MataKuliah, on_delete=models.CASCADE, related_name='daftar_soal')
    judul = models.CharField(max_length=200, help_text="Contoh: Latihan Asistensi 4 - Rekursi")
    kategori = models.CharField(max_length=20, choices=KATEGORI_CHOICES)
    tahun = models.PositiveIntegerField(default=2026, help_text="Tahun ajaran soal, misal: 2024, 2025, 2026")
    file_url = models.URLField(help_text="Link PDF Soal (Google Drive / Cloud)")
    pembahasan_url = models.URLField(blank=True, null=True, help_text="Opsional: Link PDF Pembahasan")
    deskripsi = models.TextField(blank=True, help_text="Catatan tambahan dari asdos (opsional)")
    uploaded_by = models.ForeignKey(User, on_delete=models.SET_NULL, null=True, related_name='soal_diupload')
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        ordering = ['-tahun', '-created_at']
        verbose_name_plural = "Soal"

    def __str__(self):
        return f"[{self.tahun}] {self.mata_kuliah.nama_mk} - {self.judul}"
```
